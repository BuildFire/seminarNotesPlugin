{
  "name": "updateItemAdvanced",
  "displayName": "Update item",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "alternatives": [
    {
      "operationName": "updateItem",
      "label": "Basic"
    }
  ],
  "context": {
    "functionName": "updateItemAdvanced",
    "hosts": [
      "controlBackground"
    ]
  },
  "description": "Changes a seminar item's details, only those given, using the item's id.",
  "parameters": {
    "itemId": {
      "type": "string",
      "displayName": "Item id",
      "required": true,
      "description": "The item's id, as shown in search results.",
      "sampleValue": "[item id]"
    },
    "newTitle": {
      "type": "string",
      "displayName": "New title",
      "required": false,
      "description": "The item's new title. Leave it out to keep the current one.",
      "sampleValue": "[new item title]"
    },
    "newSummary": {
      "type": "string",
      "displayName": "New summary",
      "required": false,
      "nullable": true,
      "description": "The item's new summary. Leave it out to keep the current one, or leave it empty to remove it.",
      "sampleValue": "[new item summary]"
    },
    "newDescription": {
      "type": "wysiwyg",
      "displayName": "New content",
      "required": false,
      "nullable": true,
      "description": "The item's new formatted content. Leave it out to keep the current content, or leave it empty to remove it.",
      "sampleValue": "<p>[item content]</p>"
    },
    "newPublishDate": {
      "type": "date",
      "displayName": "New publication date",
      "required": false,
      "nullable": true,
      "description": "The new publication date shown on the item. Leave it out to keep the current one, or leave it empty to remove it.",
      "sampleValue": "2026-09-01"
    },
    "newReleaseDate": {
      "type": "date",
      "displayName": "New release date",
      "required": false,
      "nullable": true,
      "description": "The new day the item appears in the app. Leave it out to keep the current one, or leave it empty to always show it.",
      "sampleValue": "2026-09-01"
    },
    "newListImage": {
      "type": "image",
      "displayName": "New list image",
      "required": false,
      "nullable": true,
      "description": "The new picture shown for the item in the list, as a list holding one image. Leave it out to keep the current one, or pass an empty list to remove it.",
      "minValue": 0,
      "maxValue": 1,
      "sampleValue": [
        "[image url]"
      ]
    },
    "newCarouselImages": {
      "type": "action",
      "displayName": "New slider pictures",
      "required": false,
      "nullable": true,
      "description": "The item's slider pictures, in order, each with its picture and what tapping it does. Replaces the current ones; leave it out to keep them, or pass an empty list to remove them.",
      "minValue": 0,
      "sampleValue": [
        {
          "title": "[picture title]",
          "action": "linkToWeb",
          "url": "https://example.com",
          "iconUrl": "[image url]"
        }
      ]
    },
    "newLinks": {
      "type": "action",
      "displayName": "New links",
      "required": false,
      "nullable": true,
      "description": "The item's links, in order, each with a title. Replaces the current ones; leave it out to keep them, or pass an empty list to remove them.",
      "minValue": 0,
      "sampleValue": [
        {
          "title": "Visit website",
          "action": "linkToWeb",
          "url": "https://example.com"
        }
      ]
    },
    "newBackgroundImage": {
      "type": "image",
      "displayName": "New background image",
      "required": false,
      "nullable": true,
      "description": "The item page's new background picture, as a list holding one image. Leave it out to keep the current one, or pass an empty list to remove it.",
      "minValue": 0,
      "maxValue": 1,
      "sampleValue": [
        "[image url]"
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the item is changed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't changed, such as no item having that id."
        },
        "result": {
          "type": "object",
          "description": "The item as it now is.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The item's id."
            },
            "title": {
              "type": "string",
              "description": "The item's title."
            },
            "summary": {
              "type": "string",
              "description": "The item's summary."
            },
            "description": {
              "type": "string",
              "description": "The item's content, formatted."
            },
            "publishDate": {
              "type": "number|string",
              "description": "The publication date, if one is set."
            },
            "releaseDate": {
              "type": "number|string",
              "description": "The day the item appears in the app, if one is set."
            },
            "isReleased": {
              "type": "boolean",
              "description": "Whether the app shows the item yet."
            },
            "listImage": {
              "type": "string",
              "description": "The picture shown for the item in the list."
            },
            "carouselImages": {
              "type": "array",
              "description": "The pictures in the item's slider, in order.",
              "items": {
                "type": "object",
                "description": "One picture.",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The picture's title."
                  },
                  "action": {
                    "type": "string",
                    "description": "What tapping it does, such as opening a website."
                  },
                  "iconUrl": {
                    "type": "string",
                    "description": "The picture's picture."
                  }
                }
              }
            },
            "links": {
              "type": "array",
              "description": "The item's links, in order.",
              "items": {
                "type": "object",
                "description": "One link.",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The link's title."
                  },
                  "action": {
                    "type": "string",
                    "description": "What tapping it does, such as opening a website."
                  }
                }
              }
            },
            "itemListBgImage": {
              "type": "string",
              "description": "The item page's background picture."
            },
            "deepLinkUrl": {
              "type": "string",
              "description": "The item's deep link."
            },
            "dateCreated": {
              "type": "number",
              "description": "When the item was added."
            },
            "rank": {
              "type": "number",
              "description": "The item's place in the manual order."
            }
          }
        }
      }
    }
  }
}

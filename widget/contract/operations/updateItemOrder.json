{
  "name": "updateItemOrder",
  "displayName": "Update item order",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "throttable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateItemOrderAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "updateItemOrder",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Moves a seminar item to another place in the manual order.",
  "parameters": {
    "title": {
      "type": "string",
      "displayName": "Item title",
      "required": true,
      "description": "The exact title of the item to move.",
      "sampleValue": "[item title]"
    },
    "position": {
      "type": "number",
      "displayName": "Position",
      "required": true,
      "minValue": 1,
      "description": "Where to move the item, counting from 1 for the top of the list.",
      "sampleValue": 1
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the item is moved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't moved, such as the items not being sorted manually."
        },
        "result": {
          "type": "object",
          "description": "The items in their new order.",
          "properties": {
            "items": {
              "type": "array",
              "description": "Every item, in the manual order.",
              "items": {
                "type": "object",
                "description": "One item.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The item's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The item's title."
                  },
                  "rank": {
                    "type": "number",
                    "description": "The item's place, counting from 0."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
